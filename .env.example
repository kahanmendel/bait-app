# העתק לקובץ .env ומלא ערכים אמיתיים. הקובץ .env לא נכנס ל-git.

# מפתח חתימת session של Flask
SECRET_KEY=change-me

# מקומית אפשר להשאיר ריק כדי להשתמש ב-sqlite:///bait_app.db
# בענן: postgresql+pg8000://USER:PASS@/DB?unix_sock=/cloudsql/INSTANCE/.s.PGSQL.5432
DATABASE_URL=

# סוד לאימות קריאות מ-Cloud Scheduler אל /cron/*
CRON_SECRET=change-me

# ===== ימות המשיח =====
# שם המערכת (מספר המערכת) והסיסמה מהממשק של ימות המשיח
YEMOT_USERNAME=
YEMOT_PASSWORD=
# סוד משותף שמצורף כ-?secret=... ב-URL של שלוחת ה-API, כדי שרק ימות תוכל לקרוא
YEMOT_API_SECRET=change-me
